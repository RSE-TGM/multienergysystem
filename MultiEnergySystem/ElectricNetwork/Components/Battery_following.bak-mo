within MultiEnergySystem.ElectricNetwork.Components;

model Battery_following
  "Battery that follows network power (no imposed power)"

  extends Icons.BatteryIcon;

  Interfaces.ElectricPortInlet inlet annotation (
    Placement(transformation(extent={{82,-10},{102,10}}),
              iconTransformation(extent={{82,-10},{102,10}})));

  // Parameters
  parameter Modelica.Units.SI.Energy E_nom = 3.2*3600*3.7 "Nominal energy [J]";
  parameter Real eta_chg(min=0, max=1) = 0.95 "Charging efficiency";
  parameter Real eta_dis(min=0, max=1) = 0.95 "Discharging efficiency";

  parameter Real SOC0(min=0, max=1) = 0.5 "Initial SOC";
  parameter Real SOC_max(min=0, max=1) = 0.9;
  parameter Real SOC_min(min=0, max=1) = 0.1;

  parameter Real SOC_eps = 1e-4;

  // Variables
  Modelica.Units.SI.Power P "Power from network (+ charge, - discharge)";
  Modelica.Units.SI.Voltage v "Bus voltage";
  Real SOC(min=0, max=1) "State of charge";

  Real aChg(min=0, max=1);
  Real aDis(min=0, max=1);

equation

  // Read voltage
  v = inlet.v;

  // FOLLOWING: prende la potenza dal nodo
  P = inlet.P;

  // Availability (limiti SOC)
  aChg = smooth(1, min(1, max(0, (SOC_max - SOC)/SOC_eps)));
  aDis = smooth(1, min(1, max(0, (SOC - SOC_min)/SOC_eps)));

  // SOC dynamics (con protezione limiti)
  der(SOC) =
    (if P >= 0 then
       eta_chg * P * aChg / E_nom
     else
       P * aDis / (eta_dis * E_nom));

initial equation
  SOC = SOC0;

end Battery_following;

within MultiEnergySystem.ElectricNetwork.Tests;
model TestBattery2
  extends Modelica.Icons.Example;
  Sources.SourceVoltage sourceVoltage annotation(
    Placement(transformation(origin = {-98, 0}, extent = {{-10, -10}, {10, 10}})));
  Components.Battery2 battery2(E_nom = 1e7, P_request = -4e3)  annotation(
    Placement(transformation(origin = {68, 0}, extent = {{10, -10}, {-10, 10}})));
  Components.ResistiveLine resistiveLine(useThermalPort = false, L = 100, A = 0.0001, rho = 1.68e-8)  annotation(
    Placement(transformation(origin = {-26, 0}, extent = {{-10, -10}, {10, 10}})));
equation
  connect(sourceVoltage.outlet, resistiveLine.electricPortInlet) annotation(
    Line(points = {{-88, 0}, {-36, 0}}, color = {56, 93, 138}));
  connect(resistiveLine.electricPortOutlet, battery2.inlet) annotation(
    Line(points = {{-16, 0}, {58, 0}}, color = {56, 93, 138}));
end TestBattery2;

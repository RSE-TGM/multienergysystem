within MultiEnergySystem.ElectricNetwork.Tests;

model Test_battery_user
  Components.Battery_following battery_following(E_nom = 1e7, SOC0 = 0.9)  annotation(
    Placement(transformation(origin = {24, -6}, extent = {{12, -12}, {-12, 12}})));
  Components.IdealUser idealUser annotation(
    Placement(transformation(origin = {-100, 0}, extent = {{-10, -10}, {10, 10}})));
  Modelica.Blocks.Sources.Ramp ramp(duration = 100, height = 10, offset = 10, startTime = 10) annotation(
    Placement(transformation(origin = {-138, 0}, extent = {{-10, -10}, {10, 10}})));
  Sources.SourceVoltage sourceVoltage annotation(
    Placement(transformation(origin = {-140, -34}, extent = {{-10, -10}, {10, 10}}, rotation = -0)));
  Components.ElectricBus2 electricBus2 annotation(
    Placement(transformation(origin = {-28, -6}, extent = {{-10, -10}, {10, 10}})));
equation
  connect(ramp.y, idealUser.P_in) annotation(
    Line(points = {{-126, 0}, {-108, 0}}, color = {0, 0, 127}));
  connect(idealUser.inlet, electricBus2.electricPortInlet) annotation(
    Line(points = {{-92, 0}, {-38, 0}}, color = {56, 93, 138}));
  connect(electricBus2.electricPortOutlet, battery_following.inlet) annotation(
    Line(points = {{-18, -6}, {12, -6}}, color = {56, 93, 138}));
  connect(sourceVoltage.outlet, electricBus2.electricPortInlet1) annotation(
    Line(points = {{-130, -34}, {-72, -34}, {-72, -12}, {-38, -12}}, color = {56, 93, 138}));
  annotation(
    Diagram(coordinateSystem(extent = {{-140, 20}, {60, -20}})));
end Test_battery_user;

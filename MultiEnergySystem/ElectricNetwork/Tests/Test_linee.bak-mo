within MultiEnergySystem.ElectricNetwork.Tests;
model Test_linee
  extends Modelica.Icons.Example;
  Sources.SourceVoltage sourceVoltage annotation(
    Placement(transformation(origin = {-92, 0}, extent = {{-10, -10}, {10, 10}})));
  Components.Battery battery(E_nom = 1e7, SOC0 = 0.2)  annotation(
    Placement(transformation(origin = {92, 0}, extent = {{12, -12}, {-12, 12}}, rotation = -0)));
  Components.SimpleLine simpleLine(useThermalPort = false)  annotation(
    Placement(transformation(extent = {{-10, -10}, {10, 10}})));
equation
  connect(sourceVoltage.outlet, simpleLine.electricPortInlet) annotation(
    Line(points = {{-82, 0}, {-10, 0}}, color = {56, 93, 138}));
  connect(simpleLine.electricPortOutlet, battery.inlet) annotation(
    Line(points = {{10, 0}, {80, 0}}, color = {56, 93, 138}));
end Test_linee;
